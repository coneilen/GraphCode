#!/usr/bin/env python3
"""A stand-in for graphcode-nod that speaks NodRuntime/PROTOCOL.md without a model.

Point GRAPHCODE_NOD_PATH at it to drive graphcode's Nod wiring end to end before the
real runtime ships. Every message runs one turn. A message containing ASK opens a
permission ask, ALLOW answers it, FAIL reports an expired sign-in, and DONE makes the
next goal check pass. argv.json in $NOD_STATE records how it was launched.
"""

import json
import os
import socket
import sys
import threading
import uuid
from datetime import datetime, timezone


def parse(argv):
    options, flags = {}, {"-p"}
    index = 0
    while index < len(argv):
        key = argv[index]
        if key.startswith("-") and index + 1 < len(argv):
            options[key.lstrip("-")] = argv[index + 1]
            index += 2
        else:
            index += 1
    return options


args = parse(sys.argv[1:])
if "p" in args:
    print("fake summary")
    sys.exit(0)

node = args.get("node", "unknown")
state = os.environ.get("NOD_STATE") or os.path.expanduser(f"~/.graphcode/nod/{node}")
os.makedirs(state, exist_ok=True)
events_path = os.path.join(state, "events.jsonl")
lock = threading.Lock()
goal_met = False
turn = 0


def last_seq():
    try:
        with open(events_path) as log:
            lines = [line for line in log.read().splitlines() if line.strip()]
        return json.loads(lines[-1])["seq"] if lines else 0
    except (OSError, ValueError, KeyError):
        return 0


seq = last_seq()


def emit(event_type, **fields):
    global seq
    with lock:
        seq += 1
        record = {"v": 1, "seq": seq, "type": event_type,
                  "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), **fields}
        with open(events_path, "a") as log:
            log.write(json.dumps(record, sort_keys=True) + "\n")


with open(os.path.join(state, "argv.json"), "a") as out:
    out.write(json.dumps(sys.argv[1:]) + "\n")

conversation = args.get("resume") or str(uuid.uuid4())
with open(os.path.join(state, "conversation.json"), "w") as out:
    json.dump({"engine": args.get("engine", "claude"), "model": args.get("model", "fake"),
               "conversationID": conversation}, out)
emit("sessionStarted", engine=args.get("engine", "claude"), model=args.get("model", "fake"),
     conversationID=conversation, resumed="resume" in args)
print(f"nod (fake) · {conversation}", flush=True)


def run_turn(text, origin):
    global turn, goal_met
    with lock:
        turn += 1
        current = turn
    emit("userMessage", id=f"u{current}", text=text, delivery="queue", attachments=[])
    emit("turnStarted", turn=current, origin=origin)
    emit("toolCall", turn=current, callID=f"c{current}", tool="Shell", title=f"Echo turn {current}")
    emit("activity", line=f"Echoing · turn {current}")
    emit("toolResult", callID=f"c{current}", status="ok", summary="exit 0", durationMs=5)
    if "ASK" in text:
        emit("permissionAsked", askID=f"a{current}", kind="network", subject="swift package resolve",
             reason="Fetches dependencies over the network.", answerableFromCard=False)
        print(f"? asks to run swift package resolve", flush=True)
        return
    if "ALLOW" in text:
        emit("permissionResolved", askID=f"a{current - 1}", decision="allowOnce")
    if "FAIL" in text:
        emit("failure", kind="signInExpired", message="Claude sign-in expired.")
        return
    if "DONE" in text:
        goal_met = True
    emit("assistantText", turn=current, messageID=f"m{current}", delta=f"Handled: {text}", final=True)
    emit("usage", inputTokens=100 * current, outputTokens=10 * current, costUSD=0.01 * current,
         contextUsed=0.01 * current)
    if args.get("loop-type") == "goal":
        emit("goalCheck", turn=current, evaluatorModel="fake",
             clauses=[{"text": "said DONE", "met": goal_met}], met=goal_met)
    emit("turnEnded", turn=current, filesChanged=0, added=0, removed=0, summary=f"Handled {text}")
    print(f"› {text}\n  done (turn {current})", flush=True)


def serve():
    path = os.path.join(state, "control.sock")
    if os.path.exists(path):
        os.unlink(path)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    server.listen(4)
    while True:
        client, _ = server.accept()
        with client, client.makefile("rw") as stream:
            for line in stream:
                try:
                    command = json.loads(line)
                except ValueError:
                    stream.write(json.dumps({"ok": False, "error": "not JSON"}) + "\n")
                    stream.flush()
                    continue
                with open(os.path.join(state, "commands.jsonl"), "a") as log:
                    log.write(json.dumps(command, sort_keys=True) + "\n")
                stream.write(json.dumps({"ok": True}) + "\n")
                stream.flush()
                if command.get("type") == "send":
                    threading.Thread(target=run_turn,
                                     args=(command.get("text", ""), command.get("delivery", "queue"))).start()


threading.Thread(target=serve, daemon=True).start()
if "prompt" in args:
    run_turn(args["prompt"], "user")
for line in sys.stdin:
    if line.strip():
        run_turn(line.strip(), "queue")
